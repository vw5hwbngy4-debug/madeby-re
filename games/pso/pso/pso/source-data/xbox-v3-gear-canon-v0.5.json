    "levelTable": "newserv system/tables/level-table-v3.json / LevelTableV3 base stats semantics",
    "license": "MIT; see THIRD_PARTY_NOTICES.txt and third-party/newserv-LICENSE.txt",
    "policy": "Only exact rows included in this curated v0.5 corpus are ranked. Unknown item parameter rows remain unranked; no stats are inferred from names."
  },
  "statSemantics": {
    "ATP": "displayLevel1ATP + (saveRawATP-newservRawLevel1ATP) + 2*MAG.POW",
    "MST": "displayLevel1MST + (saveRawMST-newservRawLevel1MST) + 2*MAG.MIND",
    "ATA": "displayLevel1ATA + (saveRawATA-newservRawLevel1ATA)/8 + MAG.DEX/2",
    "note": "Display-level calibration is the published v3 class stat scale; save growth bytes are matched to newserv LevelTableV3. Current equipped gear remains authoritative even if a future calibration source changes."
  },
